# ---------------------------------------------------------------------------
# 2. Hardware Run Function for Superdense Coding
# ---------------------------------------------------------------------------
def run_sdc_hardware_tomography(pair, backend_obj, num_shots=10000):
    # Build the circuit
    qc = QuantumCircuit(2)
    
    # Entanglement preparation
    qc.h(1)
    qc.cx(1, 0)
    qc.barrier()
    
    # Alice's encoding
    if pair[0] == '1': 
        qc.z(1)
    if pair[1] == '1': 
        qc.x(1)
    qc.barrier()
    
    # Bob's decoding
    qc.cx(1, 0)
    qc.h(1)

    # Target state for fidelity computation
    target_state = Statevector.from_label(pair)
    
    # Setup State Tomography
    qst_exp = StateTomography(qc)
    
    # Execute using Sampler V2
    sampler = Sampler(mode=backend_obj)
    tomo_data = qst_exp.run(backend_obj, sampler=sampler, shots=num_shots).block_for_results()
    
    # Extract results
    rho_fit = tomo_data.analysis_results("state").value
    fidelity = state_fidelity(target_state, rho_fit)
    
    return fidelity, rho_fit


# ---------------------------------------------------------------------------
# 3. Multi-Run Averaging Protocol 
# ---------------------------------------------------------------------------
def run_multi_trial_sdc_experiment(pair, backend_obj, num_trials=5, num_shots=10000):
    fidelities = []
    print(f"--- Running Message '{pair}' ({num_trials} trials, {num_shots} shots/basis) ---")
    
    for trial in range(1, num_trials + 1):
        fid, _ = run_sdc_hardware_tomography(pair, backend_obj, num_shots=num_shots)
        fidelities.append(fid)
        print(f"  Trial {trial}/{num_trials} Fidelity: {fid:.5f}")
    
    fidelities = np.array(fidelities)
    
    # 1. Calculate Mean
    mean_fidelity = np.mean(fidelities)
    
    # 2. Calculate Sample Standard Deviation (ddof=1 for unbiased estimator)
    std_dev = np.std(fidelities, ddof=1)
    
    # 3. Calculate Standard Error of the Mean (SEM)
    sem = std_dev / np.sqrt(num_trials)
    
    # 4. Compute Theoretical Finite Sampling Shot Noise Limit
    theoretical_shot_noise = np.sqrt(mean_fidelity * (1 - mean_fidelity) / num_shots)
    
    return mean_fidelity, std_dev, sem, theoretical_shot_noise, fidelities


# ---------------------------------------------------------------------------
# 4. Main Execution Loop Across All SDC Messages
# ---------------------------------------------------------------------------
NUM_TRIALS = 5    
SHOTS_PER_BASIS = 10000

